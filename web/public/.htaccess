# Línea 126 — Hostinger (Apache). linea126.com.ar
Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# 1) Todo a https://linea126.com.ar (sin www) con un solo 301.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://linea126.com.ar%{REQUEST_URI} [L,R=301]

# 2) Sin barra final ni .html: /horarios/ y /horarios.html → /horarios
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
# /atencion (ruta vieja) → /reclamos
RewriteRule ^atencion$ /reclamos [L,R=301]

# 3) /horarios sirve horarios.html (página pre-renderizada)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# 4) Lo que no existe: 404 real (la página de error es la app igual)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # /assets/* llevan hash en el nombre: caché de un año
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|webp|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(config\.js|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
