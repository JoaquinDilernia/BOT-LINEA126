PORT=3126
NODE_ENV=development

# IA
ANTHROPIC_API_KEY=
# Transcripción de audios (opcional)
OPENAI_API_KEY=

# Firestore compartido (pedidos-lett-2). Colecciones con prefijo bot-linea126_
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Panel
JWT_SECRET=
ADMIN_PASSWORD=
# Orígenes permitidos para el panel, separados por coma (el sitio público usa /api/public, abierto)
FRONTEND_URL=http://localhost:5173
# URL pública del backend (links de media)
PUBLIC_BASE_URL=

# WhatsApp / Instagram — VACÍAS a propósito: hoy el bot atiende sólo por el chat web.
# Para activar WhatsApp, cargar estas variables y apuntar el webhook de Meta a /api/webhook.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_IG_PAGE_ID=

# Mails al pasajero (respuesta de reclamos) vía Resend. El dominio de MAIL_FROM
# tiene que estar verificado en Resend. Sin RESEND_API_KEY no se mandan mails.
RESEND_API_KEY=
MAIL_FROM="Línea 126 <info@techdi.com.ar>"
# URL pública del sitio, para el link "Seguí tu reclamo" del mail
SITE_URL=
